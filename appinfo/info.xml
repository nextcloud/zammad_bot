<info xmlns:xsi= "http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>zammad_bot</id>
	<name>Zammad bot</name>
	<summary><![CDATA[Posts Zammad tickets into Talk when they are tagged for your team]]></summary>
	<description><![CDATA[Receives a webhook from a Zammad trigger and posts the ticket into the Talk conversation mapped to the tag that matched. Each ticket is announced only once per tag.]]></description>

	<version>1.0.0</version>
	<licence>agpl</licence>

	<author>Joas Schilling</author>

	<namespace>ZammadBot</namespace>

	<types>
		<prevent_group_restriction />
	</types>

	<category>integration</category>
	<category>social</category>

	<website>https://github.com/nextcloud/zammad_bot</website>
	<bugs>https://github.com/nextcloud/zammad_bot/issues</bugs>
	<repository>https://github.com/nextcloud/zammad_bot.git</repository>

	<dependencies>
		<nextcloud min-version="36" max-version="36" />
	</dependencies>

	<background-jobs>
		<job>OCA\ZammadBot\BackgroundJob\CleanUpNotifications</job>
	</background-jobs>

	<commands>
		<command>OCA\ZammadBot\Command\Configure</command>
		<command>OCA\ZammadBot\Command\TagSet</command>
		<command>OCA\ZammadBot\Command\TagRemove</command>
		<command>OCA\ZammadBot\Command\TagList</command>
	</commands>
</info>
